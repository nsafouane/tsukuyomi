root = true

[*.{js,py,ts,tsx}]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{yml,yml}]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md}]
charset = utf-8
max_line_length = 700
trim_trailing_whitespace = true
insert_final_newline = true
